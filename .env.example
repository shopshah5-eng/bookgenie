# Public Supabase settings used by the browser and server auth client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only key. Never expose this value to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Real generation providers.
OPENROUTER_API_KEY=your-openrouter-api-key
GEMINI_API_KEY=your-gemini-api-key
AI_IMAGE_PROVIDER=gemini

# Optional Free Alternative: NVIDIA NIM Provider
NVIDIA_API_KEY=nvapi-your-nvidia-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_TEXT_PROVIDER=nvidia
AI_TEXT_MODEL_NVIDIA=meta/llama-3.2-11b-vision-instruct

# Model selection for paid plans & speed/profit optimization
# Standard model (High speed, ~98% profit margin): deepseek/deepseek-chat or meta-llama/llama-3.1-8b-instruct
AI_TEXT_MODEL_STANDARD=deepseek/deepseek-chat
# Premium model (Creator tier / complex literature): anthropic/claude-3.5-sonnet or google/gemini-2.5-flash
AI_TEXT_MODEL_PREMIUM=anthropic/claude-3.5-sonnet

# Administrator Access: Comma-separated list of emails with access to /admin
ADMIN_EMAILS=admin@bookgenie.ai,your-email@example.com

# Canonical URL used for OAuth redirects and provider request metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay payments (required for paid one-time checkout and subscriptions)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
